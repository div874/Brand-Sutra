# ==============================================================================
# BRAND SUTRA ENVIRONMENT CONFIGURATION TEMPLATE
# For local development (.env.local) and Vercel Project Environment Variables
# ==============================================================================

# 1. Supabase (Optional: app falls back gracefully to LocalStorage if not configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. AI Audit Engine Keys (Optional: app falls back gracefully to deterministic rule engine)
GROQ_API_KEY=gsk_your_groq_api_key_here
XKIRO_API_KEY=sk-xt-your_xkiro_api_key_here
